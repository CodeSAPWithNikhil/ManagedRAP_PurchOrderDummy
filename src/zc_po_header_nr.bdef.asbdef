projection;
strict ( 2 );
use side effects;

define behavior for ZC_PO_HEADER_NR //alias <alias_name>
{
  use create;
  use update;
  use delete;
  use action approvePo;
  use action rejectPo;
  use association _PurchaseOrderItems { create; }
}

define behavior for ZC_PO_ITEM_NR //alias <alias_name>
{
  use update;
  use delete;

  use association _PurchasingOrder;
}