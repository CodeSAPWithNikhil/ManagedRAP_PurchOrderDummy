@Metadata.layer: #CUSTOMER
@UI: {
    headerInfo: {
        typeName: 'Purchase Order',
        typeNamePlural: 'Purchase Orders',
        title: {
            type: #STANDARD,
            value: 'PurchasingDocument',
            label: 'Purchase Order'
        },
        description: {
 type: #STANDARD,
            value: 'StatusText' //,
//            criticality: 'StatusCriticality',
//            criticalityRepresentation: #WITH_ICON

        }
    }
}
annotate entity ZC_PO_HEADER_NR with
{

  @UI.facet: [
    {
      id: 'GeneralInformationH',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'General Information',
      position: 10
    },
    {
      id: 'AdministrativeDataH',
      purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE,
      label: 'Administrative Data',
      position: 20
    },

    {
   id: 'Items',
   purpose: #STANDARD,
   type: #LINEITEM_REFERENCE,
   label: 'Items',
   position: 30,
   targetElement: '_PurchaseOrderItems'
  }
  ]

  @EndUserText.label: 'Purchasing Document'
  @UI.lineItem:       [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  @UI.selectionField: [{ position: 10 }]
  PurchasingDocument;

  @EndUserText.label: 'Supplier'
  @UI.lineItem:       [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  @UI.selectionField: [{ position: 20 }]
  @Consumption.valueHelpDefinition: [{
      entity: {
          name: 'zvendor_master_nr',
          element: 'vendor_id'
      },
      distinctValues: true
  }]
  //  @UI.textArrangement: #TEXT_ONLY
  Supplier;

  @EndUserText.label: 'Purchasing Document Date'
  @UI.lineItem:       [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  @UI.selectionField: [{ position: 30 }]
  PurchasingDocumentDate;

  @EndUserText.label: 'Transaction Currency'
  @UI.lineItem:       [{ position: 40 }]
  @UI.identification: [{ position: 40 }]
  TransactionCurrency;

  @EndUserText.label: 'Overall Processing Status'
  //@UI.textArrangement: #TEXT_ONLY
  @UI.lineItem:       [{ position: 50, criticality: 'StatusCriticality', criticalityRepresentation: #ONLY_ICON },
                        { type: #FOR_ACTION, dataAction: 'approvePo', label: 'Approve',invocationGrouping: #CHANGE_SET },
                       { type: #FOR_ACTION, dataAction: 'rejectPo', label: 'Reject' }]
  @UI.identification: [{ position: 50,criticality: 'StatusCriticality', criticalityRepresentation: #WITH_ICON },
                       { type: #FOR_ACTION, dataAction: 'approvePo', label: 'Approve' },
                       { type: #FOR_ACTION, dataAction: 'rejectPo', label: 'Reject' } ]
  @UI.selectionField: [{ position: 40 }]

  @Consumption.valueHelpDefinition: [{
    entity: {
        name: 'ZPo_Statuses',
        element: 'status'
    },
    distinctValues: true
  }]


  OverallProcessingStatus;

  @EndUserText.label: 'Total Net Amount'
  @UI.lineItem:       [{ position: 60 }]
  @UI.identification: [{ position: 60 }]
  TotalNetAmount;

  @EndUserText.label: 'Created On'
  @UI.identification: [{ position: 70 }]

  CreationDateTime;

  @EndUserText.label: 'Created By'
  @UI.identification: [{ position: 80 }]
  CreatedByUser;

  @EndUserText.label: 'Last Changed On'
  @UI.identification: [{ position: 90 }]
  LastChangeDateTime;

  @EndUserText.label: 'Last Changed By'
  @UI.identification: [{ position: 100 }]
  LastChangedByUser;

}
